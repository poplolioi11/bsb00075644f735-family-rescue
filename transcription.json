            {
              "text": "京華地安門外後門"
            },
            {
              "text": "橋下"
            },
            {
              "text": "水深不及一尺而淤"
            },
            {
              "text": "泥之"
            },
            {
              "text": "深可沒足踝日前有"
            },
            {
              "text": "一瘋"
            },
            {
              "text": "婦卸去衣服入河亂"
            },
            {
              "text": "滾怒"
            },
            {
              "text": "罵嬉咲不知臭穢子年"
            },
            {
              "text": "已及"
            },
            {
              "text": "十六七見母如此無限"
            },
            {
              "text": "哀痛"
            },
            {
              "text": "求人襄助救之以起"
            },
            {
              "text": "而婦"
            },
            {
              "text": "且極力蹲伏不肯出"
            },
            {
              "text": "嗚呼"
            },
            {
              "text": "犯此病者真是現在"
            },
            {
              "text": "地獄"
            }
